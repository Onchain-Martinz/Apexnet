# ─────────────────────────────────────────────
# Apex — Environment Variables Template
# Copy to .env.local and fill in all values.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Apex

# ── Database ─────────────────────────────────
# For Neon Postgres (recommended): use TWO connection strings.
#
# DATABASE_URL → Neon's pooled (PgBouncer) endpoint — used at runtime.
#   Add -pooler to the hostname and set pgbouncer=true so Prisma skips named
#   prepared statements (incompatible with PgBouncer in transaction mode).
#   connection_limit=5 is a safe default; lower to 1 for pure serverless.
#
#   Pooled hostname pattern: ep-<id>-pooler.<region>.aws.neon.tech
#
# DIRECT_URL → Neon's direct (non-pooled) endpoint — used by Prisma migrations.
#   Required because prisma migrate / db push need a real Postgres connection.
#
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=30&connection_limit=5
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=30

# ── NextAuth ─────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# ── OAuth Providers (optional) ───────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cloudflare R2 (Storage) ──────────────────
# For file/book PDF uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=apex-books
R2_PUBLIC_URL=
# Public URL for cover images — safe to expose in the client bundle.
# Set to the same value as R2_PUBLIC_URL (your R2 bucket's public domain).
NEXT_PUBLIC_R2_PUBLIC_URL=

# ── Flutterwave V3 (Payments) ────────────────
# Find all keys at: Flutterwave dashboard → Settings → API Keys → V3 Live/Test API keys
#
# Secret key — server-side only, never expose in client code.
# Format: FLWSECK-xxx (live) or FLWSECK_TEST-xxx (test)
FLW_SECRET_KEY=
# Public key — safe for client-side use, powers the Inline SDK checkout modal.
# Format: FLWPUBK-xxx (live) or FLWPUBK_TEST-xxx (test)
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
# Webhook hash — a secret string you define in:
#   Flutterwave dashboard → Settings → Webhooks → Secret Hash
# Flutterwave sends it as the "verif-hash" header on every webhook delivery.
FLUTTERWAVE_WEBHOOK_HASH=

# Pilot payout settlement window. Completed purchases become payout-eligible
# after this many hours.
SETTLEMENT_WINDOW_HOURS=24

# ── Email (Transactional) ────────────────────
# Resend is recommended
RESEND_API_KEY=
EMAIL_FROM=noreply@apexbooks.africa

# ── Email verification (OTP) ─────────────────
# Secret used to HMAC-hash OTP codes before storage. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_HMAC_SECRET=

# ── Sentry (Error Monitoring) ────────────────────
# Get your DSN from: sentry.io → Settings → Projects → Client Keys
# NEXT_PUBLIC_SENTRY_DSN is used by both the client bundle and server config.
# SENTRY_DSN (server-only, not in client bundle) takes precedence on the server.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Required for source map uploads during CI/build (optional in local dev):
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Seed: Admin user ─────────────────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Seed: Pilot lecturer (manually verified) ─────
# Run `npx prisma db seed` after setting these values.
# The created lecturer gets verified=true so they can publish immediately.
SEED_PILOT_LECTURER_EMAIL=
SEED_PILOT_LECTURER_PASSWORD=
SEED_PILOT_LECTURER_NAME=
