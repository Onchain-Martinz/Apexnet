# ─────────────────────────────────────────────
# Apex — Environment Variables Template
# Copy to .env.local and fill in all values.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Apex

# ── Database ─────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/apex

# ── NextAuth ─────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# ── OAuth Providers (optional) ───────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cloudflare R2 (Storage) ──────────────────
# For file/book PDF uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=apex-books
R2_PUBLIC_URL=

# ── Paystack (Payments) ──────────────────────
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# ── Email (Transactional) ────────────────────
# Resend is recommended
RESEND_API_KEY=
EMAIL_FROM=noreply@apexbooks.africa

# ── Seed: Admin user ─────────────────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Seed: Pilot lecturer (manually verified) ─────
# Run `npx prisma db seed` after setting these values.
# The created lecturer gets verified=true so they can publish immediately.
SEED_PILOT_LECTURER_EMAIL=
SEED_PILOT_LECTURER_PASSWORD=
SEED_PILOT_LECTURER_NAME=
