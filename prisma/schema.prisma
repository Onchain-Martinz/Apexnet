generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model University {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  shortName        String
  country          String            @default("Nigeria")
  state            String?
  logoUrl          String?
  website          String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  departments      Department[]
  lecturerProfiles LecturerProfile[]
  studentProfiles  StudentProfile[]
  textbooks        Textbook[]

  @@unique([name, country])
  @@index([shortName])
  @@index([isActive])
  @@map("universities")
}

model Department {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  universityId     String            @db.Uuid
  name             String
  code             String?
  faculty          String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  courses          Course[]
  university       University        @relation(fields: [universityId], references: [id], onDelete: Cascade)
  lecturerProfiles LecturerProfile[]
  studentProfiles  StudentProfile[]
  textbooks        Textbook[]

  @@unique([universityId, name])
  @@index([universityId])
  @@map("departments")
}

model Course {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  departmentId String     @db.Uuid
  code         String
  title        String
  level        Int
  semester     Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  textbooks    Textbook[]

  @@unique([departmentId, code])
  @@index([departmentId, level, semester])
  @@map("courses")
}

model User {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String                @unique
  name                 String?
  avatarUrl            String?
  role                 Role                  @default(STUDENT)
  hashedPassword       String?
  mustChangePassword   Boolean               @default(false)
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  emailVerifiedAt      DateTime?
  accounts             Account[]
  emailVerificationOtp EmailVerificationOtp?
  lecturerProfile      LecturerProfile?
  passwordResetOtp     PasswordResetOtp?
  purchases            Purchase[]
  readingProgress      ReadingProgress[]
  sessions             Session[]
  studentLibrary       StudentLibrary[]
  studentProfile       StudentProfile?

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model EmailVerificationOtp {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @unique @db.Uuid
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_otps")
}

model PasswordResetOtp {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @unique @db.Uuid
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_otps")
}

model StudentProfile {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String      @unique @db.Uuid
  universityId    String?     @db.Uuid
  departmentId    String?     @db.Uuid
  level           Int?
  studentIdNumber String?     @unique @map("matricNumber")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  department      Department? @relation(fields: [departmentId], references: [id])
  university      University? @relation(fields: [universityId], references: [id])
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([universityId])
  @@index([departmentId])
  @@map("student_profiles")
}

model LecturerProfile {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String              @unique @db.Uuid
  universityId          String?             @db.Uuid
  departmentId          String?             @db.Uuid
  title                 String?
  bio                   String?
  phone                 String?
  bankName              String?
  bankAccountNumber     String?
  bankAccountName       String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  verified              Boolean             @default(false)
  verifiedAt            DateTime?
  bankAccountVerifiedAt DateTime?
  bankCode              String?
  department            Department?         @relation(fields: [departmentId], references: [id])
  university            University?         @relation(fields: [universityId], references: [id])
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  payouts               Payout[]
  textbooks             Textbook[]
  withdrawalRequests    WithdrawalRequest[]

  @@index([universityId])
  @@index([departmentId])
  @@index([verified])
  @@map("lecturer_profiles")
}

model Textbook {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lecturerId      String            @db.Uuid
  universityId    String?           @db.Uuid
  departmentId    String?           @db.Uuid
  title           String
  description     String?
  coverImageKey   String?
  fileKey         String?
  isbn            String?           @unique
  edition         String?
  publicationYear Int?
  courseCode      String?
  level           Int?
  totalPages      Int?
  fileSizeBytes   BigInt?
  price           Int // Whole Naira only — no Kobo/decimals. See normalizeCourseCode-style validator in src/lib/validations/textbook.ts.
  isFree          Boolean           @default(false)
  status          TextbookStatus    @default(DRAFT)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  publishedAt     DateTime?
  courseId        String?           @db.Uuid
  purchases       Purchase[]
  readingProgress ReadingProgress[]
  studentLibrary  StudentLibrary[]
  course          Course?           @relation(fields: [courseId], references: [id])
  department      Department?       @relation(fields: [departmentId], references: [id])
  lecturer        LecturerProfile   @relation(fields: [lecturerId], references: [id])
  university      University?       @relation(fields: [universityId], references: [id])

  @@index([lecturerId])
  @@index([universityId])
  @@index([departmentId])
  @@index([courseId])
  @@index([status])
  @@index([universityId, departmentId, status])
  @@index([status, courseCode])
  @@map("textbooks")
}

model Purchase {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId        String          @db.Uuid
  textbookId       String          @db.Uuid
  payoutId         String?         @db.Uuid
  amount           Decimal         @db.Decimal(10, 2)
  currency         String          @default("NGN")
  status           PurchaseStatus  @default(PENDING)
  paymentReference String          @unique @map("paystackReference")
  paymentChannel   String?         @map("paystackChannel")
  paidAt           DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  payout           Payout?         @relation(fields: [payoutId], references: [id])
  student          User            @relation(fields: [studentId], references: [id])
  textbook         Textbook        @relation(fields: [textbookId], references: [id])
  library          StudentLibrary?

  @@index([studentId])
  @@index([textbookId])
  @@index([status])
  @@index([payoutId])
  @@index([textbookId, status])
  @@map("purchases")
}

model StudentLibrary {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId  String    @db.Uuid
  textbookId String    @db.Uuid
  purchaseId String?   @unique @db.Uuid
  expiresAt  DateTime?
  addedAt    DateTime  @default(now())
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])
  student    User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  textbook   Textbook  @relation(fields: [textbookId], references: [id])

  @@unique([studentId, textbookId])
  @@index([studentId])
  @@index([textbookId])
  @@map("student_library")
}

model ReadingProgress {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId   String   @db.Uuid
  textbookId  String   @db.Uuid
  currentPage Int      @default(0)
  totalPages  Int?
  percentage  Float    @default(0)
  lastReadAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  textbook    Textbook @relation(fields: [textbookId], references: [id], onDelete: Cascade)

  @@unique([studentId, textbookId])
  @@index([studentId])
  @@map("reading_progress")
}

model Payout {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lecturerId        String          @db.Uuid
  period            String
  purchaseCount     Int             @default(0)
  grossAmount       Decimal         @db.Decimal(12, 2)
  platformFeeRate   Decimal         @db.Decimal(5, 4)
  platformFeeAmount Decimal         @db.Decimal(12, 2)
  netAmount         Decimal         @db.Decimal(12, 2)
  currency          String          @default("NGN")
  status            PayoutStatus    @default(PENDING)
  transferCode      String?         @map("paystackTransferCode")
  failureReason     String?
  processedAt       DateTime?
  paidAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  lecturer          LecturerProfile @relation(fields: [lecturerId], references: [id])
  purchases         Purchase[]

  @@unique([lecturerId, period])
  @@index([lecturerId])
  @@index([status])
  @@map("payouts")
}

model WithdrawalRequest {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lecturerId        String           @db.Uuid
  amount            Decimal          @db.Decimal(12, 2)
  currency          String           @default("NGN")
  status            WithdrawalStatus @default(PENDING)
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  failureReason     String?
  paidAt            DateTime?
  transferCode      String?          @map("paystackTransferCode")
  transferReference String?          @unique
  failureHistory    Json?
  retryCount        Int              @default(0)
  lecturer          LecturerProfile  @relation(fields: [lecturerId], references: [id], onDelete: Cascade)

  @@index([lecturerId])
  @@index([status])
  @@map("withdrawal_requests")
}

enum Role {
  STUDENT
  LECTURER
  ADMIN
}

enum TextbookStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  PAID
  FAILED
}
