// ─────────────────────────────────────────────────────────────────────────────
// Apex — Production Schema
// Database : PostgreSQL
// IDs      : UUID v4 via gen_random_uuid() (native Postgres, no extension needed)
// Naming   : snake_case table names, camelCase Prisma fields
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  LECTURER
  ADMIN
}

enum TextbookStatus {
  DRAFT      // Saved but not yet published
  PUBLISHED  // Live and visible to students
  ARCHIVED   // Removed from catalogue
}

enum PurchaseStatus {
  PENDING   // Payment initiated, awaiting Paystack webhook
  COMPLETED // Payment confirmed, library access granted
  FAILED    // Payment failed or timed out
}

enum PayoutStatus {
  PENDING    // Earnings accumulated, not yet requested
  PROCESSING // Transfer initiated via Paystack
  PAID       // Transfer confirmed
  FAILED     // Transfer failed, needs retry
}

// ─────────────────────────────────────────────────────────────────────────────
// 1. Universities
// ─────────────────────────────────────────────────────────────────────────────

model University {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  shortName String   // e.g. "UNILAG", "ABU", "OAU"
  country   String   @default("Nigeria")
  state     String?
  logoUrl   String?
  website   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments      Department[]
  studentProfiles  StudentProfile[]
  lecturerProfiles LecturerProfile[]
  textbooks        Textbook[]

  @@unique([name, country])
  @@index([shortName])
  @@index([isActive])
  @@map("universities")
}

// ─────────────────────────────────────────────────────────────────────────────
// 2. Departments
// ─────────────────────────────────────────────────────────────────────────────

model Department {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  universityId String   @db.Uuid
  name         String   // e.g. "Computer Science"
  code         String?  // e.g. "CSC"
  faculty      String?  // e.g. "Faculty of Science"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  university       University        @relation(fields: [universityId], references: [id], onDelete: Cascade)
  studentProfiles  StudentProfile[]
  lecturerProfiles LecturerProfile[]
  textbooks        Textbook[]

  @@unique([universityId, name])
  @@index([universityId])
  @@map("departments")
}

// ─────────────────────────────────────────────────────────────────────────────
// 3. Users
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String    @unique
  name           String?
  avatarUrl      String?
  role           Role      @default(STUDENT)
  hashedPassword String?   // Null for OAuth-only accounts
  emailVerified  DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // NextAuth
  accounts Account[]
  sessions Session[]

  // Profiles (only one will be populated per user based on role)
  studentProfile  StudentProfile?
  lecturerProfile LecturerProfile?

  // Transactional relations (scoped to students only at query level)
  purchases      Purchase[]
  studentLibrary StudentLibrary[]
  readingProgress ReadingProgress[]

  @@index([role])
  @@index([isActive])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// NextAuth — Required adapter tables
// ─────────────────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// 4. Student Profiles
// ─────────────────────────────────────────────────────────────────────────────

model StudentProfile {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @unique @db.Uuid
  universityId   String?  @db.Uuid
  departmentId   String?  @db.Uuid
  // Academic level: 100 | 200 | 300 | 400 | 500 — Int avoids rigid enum
  level          Int?
  matricNumber   String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  university University? @relation(fields: [universityId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([universityId])
  @@index([departmentId])
  @@map("student_profiles")
}

// ─────────────────────────────────────────────────────────────────────────────
// 5. Lecturer Profiles
// ─────────────────────────────────────────────────────────────────────────────

model LecturerProfile {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @unique @db.Uuid
  universityId String?  @db.Uuid
  departmentId String?  @db.Uuid
  title        String?  // e.g. "Dr.", "Prof.", "Mr."
  bio          String?  @db.Text
  verified     Boolean   @default(false)
  verifiedAt   DateTime?

  // Bank details for payouts — store encrypted at app layer before saving
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?
  paystackRecipientCode String? // Created once via Paystack Transfer Recipients API

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  university University? @relation(fields: [universityId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  textbooks  Textbook[]
  payouts    Payout[]
  withdrawalRequests WithdrawalRequest[]

  @@index([universityId])
  @@index([departmentId])
  @@index([verified])
  @@map("lecturer_profiles")
}

// ─────────────────────────────────────────────────────────────────────────────
// 6. Textbooks
// ─────────────────────────────────────────────────────────────────────────────

model Textbook {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lecturerId   String         @db.Uuid
  universityId String?        @db.Uuid
  departmentId String?        @db.Uuid

  title          String
  description    String?        @db.Text
  coverImageKey  String?        // Cloudflare R2 object key
  fileKey        String?        // Cloudflare R2 object key (PDF)
  isbn           String?        @unique
  edition        String?        // e.g. "3rd"
  publicationYear Int?
  courseCode     String?        // e.g. "CSC 301"
  // Target academic level: 100–500, null = all levels
  level          Int?
  totalPages     Int?
  fileSizeBytes  BigInt?

  price    Decimal        @db.Decimal(10, 2)
  isFree   Boolean        @default(false)
  status   TextbookStatus @default(DRAFT)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lecturer   LecturerProfile @relation(fields: [lecturerId], references: [id])
  university University?     @relation(fields: [universityId], references: [id], onDelete: SetNull)
  department Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  purchases      Purchase[]
  studentLibrary StudentLibrary[]
  readingProgress ReadingProgress[]

  @@index([lecturerId])
  @@index([universityId])
  @@index([departmentId])
  @@index([status])
  // Compound: common query — books available at a specific university/department
  @@index([universityId, departmentId, status])
  @@map("textbooks")
}

// ─────────────────────────────────────────────────────────────────────────────
// 7. Purchases
// ─────────────────────────────────────────────────────────────────────────────

model Purchase {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId  String         @db.Uuid
  textbookId String         @db.Uuid
  payoutId   String?        @db.Uuid // Set when included in a lecturer payout

  amount   Decimal        @db.Decimal(10, 2)
  currency String         @default("NGN")
  status   PurchaseStatus @default(PENDING)

  // Paystack fields
  paystackReference  String   @unique // Our generated reference sent to Paystack
  paystackAccessCode String?           // Returned by Paystack on initialise
  paystackChannel    String?           // e.g. "card", "bank", "ussd"

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  student  User             @relation(fields: [studentId], references: [id])
  textbook Textbook         @relation(fields: [textbookId], references: [id])
  payout   Payout?          @relation(fields: [payoutId], references: [id])
  library  StudentLibrary?  // Created on COMPLETED

  @@index([studentId])
  @@index([textbookId])
  @@index([status])
  @@index([payoutId])
  // Compound: lecturer earnings — joins via textbook.lecturerId
  @@index([textbookId, status])
  @@map("purchases")
}

// ─────────────────────────────────────────────────────────────────────────────
// 8. Student Library
// Represents access rights — one row per (student, textbook) pair.
// Created automatically when a purchase completes, or directly for free books.
// ─────────────────────────────────────────────────────────────────────────────

model StudentLibrary {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId  String   @db.Uuid
  textbookId String   @db.Uuid
  purchaseId String?  @unique @db.Uuid // Null for free textbooks
  // Null expiresAt = perpetual access (standard purchase)
  expiresAt  DateTime?
  addedAt    DateTime  @default(now())

  student  User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  textbook Textbook  @relation(fields: [textbookId], references: [id])
  purchase Purchase? @relation(fields: [purchaseId], references: [id])

  @@unique([studentId, textbookId])
  @@index([studentId])
  @@index([textbookId])
  @@map("student_library")
}

// ─────────────────────────────────────────────────────────────────────────────
// 9. Reading Progress
// Upserted on every meaningful page turn. One row per (student, textbook).
// ─────────────────────────────────────────────────────────────────────────────

model ReadingProgress {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId   String   @db.Uuid
  textbookId  String   @db.Uuid
  currentPage Int      @default(0)
  totalPages  Int?
  percentage  Float    @default(0) // 0.0 – 100.0
  lastReadAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student  User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  textbook Textbook @relation(fields: [textbookId], references: [id], onDelete: Cascade)

  @@unique([studentId, textbookId])
  @@index([studentId])
  @@map("reading_progress")
}

// ─────────────────────────────────────────────────────────────────────────────
// 10. Payouts
// Represents a batch payout to a lecturer for a given billing period.
// Linked to the individual purchases that compose it via Purchase.payoutId.
// ─────────────────────────────────────────────────────────────────────────────

model Payout {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lecturerId String   @db.Uuid

  // Billing period in ISO format: "2025-05" (YYYY-MM)
  period        String
  purchaseCount Int    @default(0)

  grossAmount      Decimal @db.Decimal(12, 2) // Sum of purchase amounts
  platformFeeRate  Decimal @db.Decimal(5, 4)  // e.g. 0.2000 = 20%
  platformFeeAmount Decimal @db.Decimal(12, 2)
  netAmount        Decimal @db.Decimal(12, 2)  // grossAmount − platformFeeAmount
  currency         String  @default("NGN")

  status PayoutStatus @default(PENDING)

  // Paystack Transfer fields — populated when status moves to PROCESSING
  paystackTransferCode String?
  failureReason        String? @db.Text

  processedAt DateTime? // When transfer was initiated
  paidAt      DateTime? // When transfer was confirmed
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lecturer  LecturerProfile @relation(fields: [lecturerId], references: [id])
  purchases Purchase[]

  @@unique([lecturerId, period]) // One payout per lecturer per billing period
  @@index([lecturerId])
  @@index([status])
  @@map("payouts")
}

// ─────────────────────────────────────────────────────────────────────────────

enum WithdrawalStatus {
  PENDING  // Submitted by lecturer, awaiting admin review
  APPROVED // Approved by admin (manual transfer happens outside the app)
  REJECTED // Rejected by admin
}

model WithdrawalRequest {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lecturerId String @db.Uuid

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("NGN")

  status     WithdrawalStatus @default(PENDING)
  reviewedAt DateTime?
  reviewNote String?          @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lecturer LecturerProfile @relation(fields: [lecturerId], references: [id], onDelete: Cascade)

  @@index([lecturerId])
  @@index([status])
  @@map("withdrawal_requests")
}
